{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Verification Failure Isolation and Retry",
    "output": "failure-isolation.sequence.html",
    "viewBox": [
      1550,
      900
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "graphql-failure",
        "label": "GraphQL failure",
        "focus": [
          "github-rest",
          "github-graphql",
          "connector",
          "relay"
        ],
        "note": "Low-level events continue; incomplete review evidence never becomes zero findings."
      },
      {
        "id": "relay-retry",
        "label": "Relay retry",
        "focus": [
          "connector",
          "analyzer",
          "relay"
        ],
        "note": "Ordinary Relay unavailability retains an eligible identity for later retry."
      },
      {
        "id": "head-drift",
        "label": "Head drift",
        "focus": [
          "github-rest",
          "connector",
          "relay"
        ],
        "note": "A final-head mismatch deletes the observation and suppresses stale notification."
      }
    ]
  },
