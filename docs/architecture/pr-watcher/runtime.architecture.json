  "cards": [
    {
      "dot": "emerald",
      "title": "Current implementation",
      "items": [
        "Connector owns cross-source settlement and deterministic heuristics",
        "Existing automation and CI events remain additive",
        "No LLM participates in verdict or action generation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Delivery contract",
      "items": [
        "Notification definitions have a dedicated acquisition kind",
        "relay notify prints before internal acknowledgment",
        "Crash between print and acknowledgment may replay"
      ]
    },
    {
      "dot": "orange",
      "title": "Future aggregation families",
      "items": [
        "A durable Relay reducer may later consume low-level events",
        "The event and notification contracts remain reusable",
        "Migration must preserve version and idempotency semantics"
      ]
    }
  ]
