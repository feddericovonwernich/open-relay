{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Single-consumer Notification Delivery",
    "output": "notification-delivery.sequence.html",
    "viewBox": [
      1550,
      790
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "hidden-lease",
        "label": "Hidden lease lifecycle",
        "focus": [
          "supervisor",
          "notify",
          "authority-files",
          "relay-http",
          "dispatcher",
          "store",
          "agent"
        ],
        "note": "The CLI registers, claims, starts, prints, and completes without exposing protocol ceremony."
      },
      {
        "id": "at-least-once",
        "label": "At-least-once replay",
        "focus": [
          "notify",
          "dispatcher",
          "store",
          "agent"
        ],
        "note": "A crash after print but before acknowledgment may deliver the same payload again after lease expiry."
      }
    ]
  },
  "participants": [
    {
      "id": "supervisor",
      "type": "cloud",
      "label": "Process Supervisor"
    },
    {
      "id": "notify",
      "type": "frontend",
      "label": "relay notify"
    },
    {
      "id": "authority-files",
      "type": "database",
      "label": "Lease Files"
    },
    {
      "id": "relay-http",
      "type": "security",
      "label": "Relay HTTP"
    },
    {
      "id": "dispatcher",
      "type": "backend",
      "label": "Dispatcher"
    },
    {
      "id": "store",
      "type": "database",
      "label": "SQLite Store"
    },
    {
      "id": "agent",
      "type": "external",
      "label": "Coding Agent"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 515,
      "label": "Successful delivery"
    },
    {
      "from": 520,
      "to": 710,
      "label": "Crash after print, before acknowledgment"
    }
  ],
  "messages": [
    {
      "id": "start-notify",
      "from": "supervisor",
      "to": "notify",
      "y": 165,
      "label": "start with definition + PR correlation",
      "variant": "emphasis"
    },
    {
      "id": "register",
      "from": "notify",
      "to": "relay-http",
      "y": 193,
      "label": "register ephemeral notify worker",
      "variant": "security"
    },
    {
      "id": "worker-token",
      "from": "relay-http",
      "to": "notify",
      "y": 221,
      "label": "scoped worker token",
      "variant": "return"
    },
    {
      "id": "poll-notification",
      "from": "notify",
      "to": "relay-http",
      "y": 249,
      "label": "poll notification-only endpoint",
      "variant": "emphasis"
    },
    {
      "id": "acquire-notification",
      "from": "relay-http",
      "to": "dispatcher",
      "y": 277,
      "label": "acquireNotification",
      "variant": "default"
    },
    {
      "id": "lease-transaction",
      "from": "dispatcher",
      "to": "store",
      "y": 305,
      "label": "atomic single-consumer lease",
      "variant": "security"
    },
    {
      "id": "delivery",
      "from": "store",
      "to": "notify",
      "y": 333,
      "label": "matching analyzed payload + lease",
      "variant": "return"
    },
    {
      "id": "persist-authority",
      "from": "notify",
      "to": "authority-files",
      "y": 361,
      "label": "persist mode-0600 local authority",
      "variant": "security"
    },
    {
      "id": "start-transition",
      "from": "notify",
      "to": "relay-http",
      "y": 389,
      "label": "internal start transition",
      "variant": "default"
    },
    {
      "id": "print-payload",
      "from": "notify",
      "to": "agent",
      "y": 417,
      "label": "write one analyzed JSON line",
      "variant": "emphasis"
    },
    {
      "id": "stdout-ok",
      "from": "agent",
      "to": "notify",
      "y": 445,
      "label": "stdout write completed",
      "variant": "return"
    },
    {
      "id": "complete-delivery",
      "from": "notify",
      "to": "relay-http",
      "y": 473,
      "label": "complete { delivered: true }",
      "variant": "emphasis"
    },
    {
      "id": "settle-event",
      "from": "relay-http",
      "to": "store",
      "y": 501,
      "label": "commit notification completion",
      "variant": "security"
    },
    {
      "id": "second-lease",
      "from": "notify",
      "to": "dispatcher",
      "y": 529,
      "label": "poll and claim another notification",
      "variant": "default"
    },
    {
      "id": "second-print",
      "from": "notify",
      "to": "agent",
      "y": 557,
      "label": "print payload",
      "variant": "emphasis"
    },
    {
      "id": "crash",
      "from": "supervisor",
      "to": "notify",
      "y": 585,
      "label": "process exits before completion",
      "variant": "dashed"
    },
    {
      "id": "lease-expiry",
      "from": "dispatcher",
      "to": "store",
      "y": 613,
      "label": "lease expires; schedule retry",
      "variant": "security"
    },
    {
      "id": "restart",
      "from": "supervisor",
      "to": "notify",
      "y": 641,
      "label": "restart relay notify",
      "variant": "default"
    },
    {
      "id": "reacquire",
      "from": "notify",
      "to": "dispatcher",
      "y": 669,
      "label": "reacquire retryable notification",
      "variant": "security"
    },
    {
      "id": "reprint",
      "from": "notify",
      "to": "agent",
      "y": 697,
      "label": "print again, then complete",
      "variant": "emphasis"
    }
  ],
  "activations": [
    {
      "participant": "notify",
      "from": 160,
      "to": 705,
      "type": "frontend"
    },
    {
      "participant": "authority-files",
      "from": 356,
      "to": 369,
      "type": "database"
    },
    {
      "participant": "relay-http",
      "from": 188,
      "to": 509,
      "type": "security"
    },
    {
      "participant": "dispatcher",
      "from": 272,
      "to": 677,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 300,
      "to": 621,
      "type": "database"
    },
    {
      "participant": "agent",
      "from": 412,
      "to": 705,
      "type": "external"
    }
  ]
}
